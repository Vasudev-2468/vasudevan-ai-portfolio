# Root .env consumed by docker-compose. Copy to .env and edit.

# Required to enable LLM-backed RAG assistant and Portfolio Manager Agent.
ANTHROPIC_API_KEY=

# Bearer token for /admin and /api/admin/*. Change before exposing.
ADMIN_TOKEN=change-me-in-env

# Optional model overrides — defaults match production-grade Claude tier.
LLM_CHAT_MODEL=claude-haiku-4-5-20251001
LLM_AGENT_MODEL=claude-sonnet-4-6

# ── Contact-form notifications (all optional) ────────────────────────────
# Set SMTP_* + NOTIFY_EMAIL_TO to receive an email per new contact message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
# OR (instead of, or alongside): post the message to any JSON webhook
# (Slack incoming webhook URL works out of the box; Discord too).
NOTIFY_WEBHOOK_URL=
