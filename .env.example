# Root .env consumed by docker-compose. Copy to .env and edit.

# ── Site / SEO ───────────────────────────────────────────────────────────
# Canonical origin the frontend uses for OpenGraph URLs, sitemap.xml,
# robots.txt, and the Person JSON-LD block. Set this to the public URL
# once you're live (e.g. https://vasudevan.ai). Missing = localhost.
NEXT_PUBLIC_SITE_URL=

# ── LLM (Anthropic Claude) ───────────────────────────────────────────────
# Required to enable LLM-backed RAG assistant, AI Avatar, and the
# Portfolio Manager Agent. Without it, both endpoints degrade to the
# keyword-search fallback (still functional, less natural).
ANTHROPIC_API_KEY=
LLM_CHAT_MODEL=claude-haiku-4-5-20251001
LLM_AGENT_MODEL=claude-sonnet-4-6

# ── AI Avatar — talking-head + voice providers (all optional) ────────────
# Default `browser-photo` provider works with zero keys (photo + Web
# Audio lip-sync + browser speechSynthesis). Setting any provider key
# switches the corresponding tier on automatically.
AVATAR_PROVIDER=browser-photo   # browser-photo | did | heygen | simli
DID_API_KEY=
HEYGEN_API_KEY=
SIMLI_API_KEY=
ELEVENLABS_API_KEY=              # server-side neural TTS (recommended)
TTS_VOICE_ID=                    # ElevenLabs voice id (optional)

# ── Admin auth ───────────────────────────────────────────────────────────
# HMAC secret for signing 2FA challenge tokens and session cookies. If
# left blank the app generates a fresh one at import time, which
# invalidates in-flight 2FA challenges on every restart — set this in
# production.
SECRET_KEY=

# Set true when the site is served over HTTPS (Set-Cookie Secure flag).
# Leave false for local http://localhost:4000 development.
COOKIE_SECURE=false

# Comma-separated CORS origins allowed to hit /api. Defaults to
# localhost:4000 / :3000 when blank.
CORS_ORIGINS=

# ── Postgres ─────────────────────────────────────────────────────────────
# Change the password before exposing the stack. Default `vasudevan`
# only exists for the zero-config first boot on a private LAN.
POSTGRES_PASSWORD=vasudevan

# ── Contact-form notifications (all optional) ────────────────────────────
# Set SMTP_* + NOTIFY_EMAIL_TO to receive an email per new contact message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
# OR (instead of, or alongside): post the message to any JSON webhook
# (Slack incoming webhook URL works out of the box; Discord too).
NOTIFY_WEBHOOK_URL=
