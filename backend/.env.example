# Copy to .env for local (non-docker) runs.
DATABASE_URL=sqlite+aiosqlite:///./vasudevan.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vasudevan-knowledge
UPLOAD_DIR=./uploads

# Anthropic — leave blank to use deterministic keyword fallback.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_CHAT_MODEL=claude-haiku-4-5-20251001
LLM_AGENT_MODEL=claude-sonnet-4-6

# Bearer token required on every /api/admin/* request.
ADMIN_TOKEN=change-me-in-env
